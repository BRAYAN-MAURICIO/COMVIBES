# Copia este archivo como .env y ajusta los valores a tu entorno.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# URL base del API. Debe coincidir con el PORT del backend.
VITE_API_URL=http://localhost:4000/api

# URL del backend sin /api — se usa para construir la ruta de las
# imágenes de producto subidas por el admin (/uploads/productos/...).
VITE_BACKEND_URL=http://localhost:4000
