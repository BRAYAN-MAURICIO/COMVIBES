# Copia este archivo como .env y ajusta los valores a tu entorno.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

PORT=4000

# ── Base de datos ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=combives_db

# ── Sesiones ─────────────────────────────────────────────────────────
# Cadena larga y aleatoria. Si cambia, todas las sesiones abiertas caducan.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────────────
# Origen permitido para CORS: la URL donde corre el frontend.
# En producción es obligatorio ponerlo al dominio real.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_BASE_URL=http://localhost:4000

# ── Correo (Nodemailer) ──────────────────────────────────────────────
# Necesario para el registro (verificación de cuenta) y la recuperación
# de contraseña. Con Gmail hace falta una CONTRASEÑA DE APLICACIÓN, no la
# contraseña normal de la cuenta:
#   1. Cuenta de Google → Seguridad → activar "Verificación en 2 pasos"
#   2. https://myaccount.google.com/apppasswords → crear una para "Correo"
#   3. Pegar aquí los 16 caracteres
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
MAIL_FROM=ComVibes <tucuenta@gmail.com>

# Solo para desarrollo sin internet: imprime los correos en la terminal
# en vez de enviarlos. Dejar comentado en cualquier entorno real.
# MAIL_TRANSPORT=console
